<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0"
  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_onboarding_m7"
  targetNamespace="http://bpmn.io/schema/bpmn"
  exporter="m7-processos/drawing-bpmn-flowcharts"
  exporterVersion="1.1.0">

  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="pool1_participant" name="M7 Investimentos" processRef="pool1" />
  </bpmn:collaboration>

  <bpmn:process id="pool1" name="M7 Investimentos" isExecutable="false">

    <bpmn:laneSet id="LaneSet_pool1">
      <bpmn:lane id="lane-comercial" name="Comercial">
        <bpmn:flowNodeRef>n1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-compliance" name="Compliance">
        <bpmn:flowNodeRef>n4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane-ops" name="Operacoes">
        <bpmn:flowNodeRef>n6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>n7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="n1" name="Lead recebido">
      <bpmn:outgoing>e1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="n2" name="Qualificar lead">
      <bpmn:documentation>Analisa fit do lead com criterios M7 (perfil, ticket, segmento)</bpmn:documentation>
      <bpmn:incoming>e1</bpmn:incoming>
      <bpmn:outgoing>e2</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="n3" name="Aprovado?" default="e4">
      <bpmn:incoming>e2</bpmn:incoming>
      <bpmn:outgoing>e3</bpmn:outgoing>
      <bpmn:outgoing>e4</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="n4" name="Validar KYC">
      <bpmn:documentation>Valida documentos e checks de compliance regulatorio</bpmn:documentation>
      <bpmn:incoming>e3</bpmn:incoming>
      <bpmn:outgoing>e5</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="n5" name="KYC ok?" default="e7">
      <bpmn:incoming>e5</bpmn:incoming>
      <bpmn:outgoing>e6</bpmn:outgoing>
      <bpmn:outgoing>e7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="n6" name="Abrir conta">
      <bpmn:documentation>Cria conta no sistema core, envia credenciais</bpmn:documentation>
      <bpmn:incoming>e6</bpmn:incoming>
      <bpmn:outgoing>e8</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="n7" name="Cliente ativo">
      <bpmn:incoming>e8</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="n8" name="Lead descartado">
      <bpmn:incoming>e4</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="n9" name="Bloqueado por compliance">
      <bpmn:incoming>e7</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="e1" sourceRef="n1" targetRef="n2" />
    <bpmn:sequenceFlow id="e2" sourceRef="n2" targetRef="n3" />
    <bpmn:sequenceFlow id="e3" name="Sim" sourceRef="n3" targetRef="n4" />
    <bpmn:sequenceFlow id="e4" name="Nao" sourceRef="n3" targetRef="n8" />
    <bpmn:sequenceFlow id="e5" sourceRef="n4" targetRef="n5" />
    <bpmn:sequenceFlow id="e6" name="Sim" sourceRef="n5" targetRef="n6" />
    <bpmn:sequenceFlow id="e7" name="Nao" sourceRef="n5" targetRef="n9" />
    <bpmn:sequenceFlow id="e8" sourceRef="n6" targetRef="n7" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">

      <bpmndi:BPMNShape id="pool1_participant_di" bpmnElement="pool1_participant" isHorizontal="true"
                        bioc:fill="#fffdef" bioc:stroke="#424135">
        <dc:Bounds x="160" y="0" width="1240" height="390" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="lane-comercial_di" bpmnElement="lane-comercial" isHorizontal="true"
                        bioc:fill="#ffffff" bioc:stroke="#424135">
        <dc:Bounds x="160" y="30" width="1240" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane-compliance_di" bpmnElement="lane-compliance" isHorizontal="true"
                        bioc:fill="#ffffff" bioc:stroke="#424135">
        <dc:Bounds x="160" y="150" width="1240" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane-ops_di" bpmnElement="lane-ops" isHorizontal="true"
                        bioc:fill="#ffffff" bioc:stroke="#424135">
        <dc:Bounds x="160" y="270" width="1240" height="120" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="n1_di" bpmnElement="n1" bioc:fill="#eef77c" bioc:stroke="#424135">
        <dc:Bounds x="252" y="72" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="n2_di" bpmnElement="n2" bioc:fill="#fdfbe5" bioc:stroke="#424135">
        <dc:Bounds x="370" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="n3_di" bpmnElement="n3" isMarkerVisible="true"
                        bioc:fill="#fef3a8" bioc:stroke="#424135">
        <dc:Bounds x="545" y="65" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="n4_di" bpmnElement="n4" bioc:fill="#fdfbe5" bioc:stroke="#424135">
        <dc:Bounds x="670" y="170" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="n5_di" bpmnElement="n5" isMarkerVisible="true"
                        bioc:fill="#fef3a8" bioc:stroke="#424135">
        <dc:Bounds x="845" y="185" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="n6_di" bpmnElement="n6" bioc:fill="#fdfbe5" bioc:stroke="#424135">
        <dc:Bounds x="970" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="n7_di" bpmnElement="n7" bioc:fill="#b8000f" bioc:stroke="#424135">
        <dc:Bounds x="1152" y="312" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="n8_di" bpmnElement="n8" bioc:fill="#b8000f" bioc:stroke="#424135">
        <dc:Bounds x="702" y="72" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="n9_di" bpmnElement="n9" bioc:fill="#b8000f" bioc:stroke="#424135">
        <dc:Bounds x="1002" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="e1_di" bpmnElement="e1" bioc:stroke="#424135">
        <di:waypoint x="288" y="90" />
        <di:waypoint x="370" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e2_di" bpmnElement="e2" bioc:stroke="#424135">
        <di:waypoint x="470" y="90" />
        <di:waypoint x="545" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e3_di" bpmnElement="e3" bioc:stroke="#424135">
        <di:waypoint x="595" y="90" />
        <di:waypoint x="632" y="90" />
        <di:waypoint x="632" y="210" />
        <di:waypoint x="670" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e4_di" bpmnElement="e4" bioc:stroke="#424135">
        <di:waypoint x="595" y="90" />
        <di:waypoint x="702" y="90" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e5_di" bpmnElement="e5" bioc:stroke="#424135">
        <di:waypoint x="770" y="210" />
        <di:waypoint x="845" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e6_di" bpmnElement="e6" bioc:stroke="#424135">
        <di:waypoint x="895" y="210" />
        <di:waypoint x="932" y="210" />
        <di:waypoint x="932" y="330" />
        <di:waypoint x="970" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e7_di" bpmnElement="e7" bioc:stroke="#424135">
        <di:waypoint x="895" y="210" />
        <di:waypoint x="1002" y="210" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e8_di" bpmnElement="e8" bioc:stroke="#424135">
        <di:waypoint x="1070" y="330" />
        <di:waypoint x="1152" y="330" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>

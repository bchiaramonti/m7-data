<?xml version="1.0" encoding="UTF-8"?>
<!--
  Esqueleto BPMN 2.0 para a skill drawing-bpmn-flowcharts.

  Placeholders:
    {{DEFINITIONS_ID}}        - id unico do definitions
    {{TARGET_NAMESPACE}}      - target namespace (default http://bpmn.io/schema/bpmn)
    {{COLLABORATION_ID}}      - id da collaboration (ex: Collaboration_1)
    {{PARTICIPANTS}}          - participants (1 por pool)
    {{MESSAGE_FLOWS}}         - message flows entre pools (se houver)
    {{PROCESSES}}             - processes (1 por pool, com laneSet + flow nodes + sequence flows)
    {{BPMN_DIAGRAM_PLANE}}    - BPMNPlane id (geralmente BPMNPlane_1)
    {{BPMN_SHAPES}}           - todos os BPMNShape (pools, lanes, flow nodes)
    {{BPMN_EDGES}}            - todos os BPMNEdge (sequence/message/association flows)

  Namespaces declarados:
    bpmn    - BPMN 2.0 Model (omg)
    bpmndi  - BPMN Diagram Interchange (omg)
    dc      - Diagram Common (omg)
    di      - Diagram Interchange (omg)
    xsi     - XML Schema Instance (w3)
    bioc    - bpmn.io / Camunda colors (rendering)
    color   - OMG non-normative color (alternativa)
    zeebe   - Camunda 8 Zeebe extensions (AI agents, workers)
    camunda - Camunda 7/Modeler extensions (compatibility)
-->
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0"
  xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0"
  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="{{DEFINITIONS_ID}}"
  targetNamespace="{{TARGET_NAMESPACE}}"
  exporter="m7-processos/drawing-bpmn-flowcharts"
  exporterVersion="1.1.0">

  <bpmn:collaboration id="{{COLLABORATION_ID}}">
    {{PARTICIPANTS}}
    {{MESSAGE_FLOWS}}
  </bpmn:collaboration>

  {{PROCESSES}}

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="{{BPMN_DIAGRAM_PLANE}}" bpmnElement="{{COLLABORATION_ID}}">
      {{BPMN_SHAPES}}
      {{BPMN_EDGES}}
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
